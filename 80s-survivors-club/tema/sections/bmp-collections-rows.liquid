{%- comment -%}
  Collections page: one row per collection, with its first designs underneath.
  Order of rows = order of blocks in the theme editor.
{%- endcomment -%}
<style>
  #bmp-coll-{{ section.id }} { padding: 48px 0 32px; }
  #bmp-coll-{{ section.id }} .bmp-coll__title { margin: 0 0 8px; text-transform: uppercase; }
  #bmp-coll-{{ section.id }} .bmp-coll__sub { margin: 0 0 32px; opacity: .7; }
  #bmp-coll-{{ section.id }} .bmp-coll-row { margin: 0 0 40px; }
  #bmp-coll-{{ section.id }} .bmp-coll-row__head { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; border-bottom: 1px solid rgba(0,0,0,.15); padding-bottom: 8px; margin-bottom: 16px; }
  #bmp-coll-{{ section.id }} .bmp-coll-row__name { margin: 0; font-size: 1.125rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; display: flex; align-items: center; gap: 10px; }
  #bmp-coll-{{ section.id }} .bmp-coll-row__badge { background: #c8102e; color: #fff; font-size: .6875rem; font-weight: 600; letter-spacing: .05em; padding: 3px 8px; }
  #bmp-coll-{{ section.id }} .bmp-coll-row__all { font-size: .875rem; font-weight: 600; color: #c8102e; text-decoration: none; white-space: nowrap; }
  #bmp-coll-{{ section.id }} .bmp-coll-row__items { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 24px; }
  @media (max-width: 749px) {
    #bmp-coll-{{ section.id }} .bmp-coll-row__items { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; gap: 12px; margin-inline: calc(var(--page-margin, 16px) * -1); padding-inline: var(--page-margin, 16px); scrollbar-width: none; }
    #bmp-coll-{{ section.id }} .bmp-coll-row__items::-webkit-scrollbar { display: none; }
    #bmp-coll-{{ section.id }} .bmp-coll-row__item { flex: 0 0 42%; scroll-snap-align: start; }
    #bmp-coll-{{ section.id }} .bmp-coll-row__name { font-size: 1rem; }
  }
</style>

<div id="bmp-coll-{{ section.id }}" class="section section--page-width">
  {%- if section.settings.heading != blank -%}
    <h1 class="bmp-coll__title h2">{{ section.settings.heading }}</h1>
  {%- endif -%}
  {%- if section.settings.subheading != blank -%}
    <p class="bmp-coll__sub">{{ section.settings.subheading }}</p>
  {%- endif -%}

  {%- for block in section.blocks -%}
    {%- assign c = block.settings.collection -%}
    {%- assign card_prefix = block.id | append: '-' -%}
    {%- if c != blank and c.products_count > 0 -%}
      <div class="bmp-coll-row" {{ block.shopify_attributes }}>
        <div class="bmp-coll-row__head">
          <h2 class="bmp-coll-row__name">
            <a href="{{ c.url }}" style="color:inherit;text-decoration:none">{{ block.settings.title | default: c.title }}</a>
            {%- if block.settings.badge != blank -%}<span class="bmp-coll-row__badge">{{ block.settings.badge }}</span>{%- endif -%}
          </h2>
          <a class="bmp-coll-row__all" href="{{ c.url }}">View all ({{ c.products_count }}) &rarr;</a>
        </div>
        <div class="bmp-coll-row__items">
          {%- for product in c.products limit: section.settings.products_per_row -%}
            <div class="bmp-coll-row__item">
              {% render 'bmp-global-product-card', product: product, loading: 'lazy', image_sizes: '(min-width: 750px) 25vw, 42vw', id_prefix: card_prefix %}
            </div>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "Collections rows",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "COLLECTIONS" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Pick your poison. Every collection, with a taste of what’s inside." },
    { "type": "range", "id": "products_per_row", "label": "Designs per collection", "min": 3, "max": 8, "step": 1, "default": 4 }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Collection row",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "title", "label": "Custom title (optional)" },
        { "type": "text", "id": "badge", "label": "Badge (optional)" }
      ]
    }
  ]
}
{% endschema %}
