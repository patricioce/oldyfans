  {%- endcapture -%}
  {%- liquid
    assign bmp_swatch_override_lookup = settings.bmp_swatch_value_list | replace: '"', '' | downcase | newline_to_br | replace: '<br />', '|' | strip_newlines | prepend: '|' | append: '|'
    assign bmp_swatch_default_lookup = bmp_swatch_default_value_list | replace: '"', '' | downcase | newline_to_br | replace: '<br />', '|' | strip_newlines | prepend: '|' | append: '|'
  -%}
  {%- if mode == 'option_any' -%}
    {%- comment -%}
      Boundary-key presence check only, reusing the two lookup strings the value
      branch builds. It deliberately stops at "is there a row" and does not run
      the hex validator: the baked defaults are already pinned row-by-row by
      scripts/check-swatch-fallback.mjs, so the only way to reach a present-but-
      invalid row is a typo in the merchant override textarea. That value then
      renders as Horizon's neutral unavailable swatch, which is the same thing
      it does today — a wrong-but-safe circle, never a crash.

      Breaks on the first hit, so the common mapped option costs one comparison.
      The loop is over option values, not over the 241 defaults, which is what
      the gate's no-Liquid-loop rule is protecting.
    {%- endcomment -%}
    {%- liquid
      assign bmp_swatch_any_hit = false
      for bmp_swatch_any_value in values
        assign bmp_swatch_any_key = bmp_swatch_any_value.name | strip | replace: '"', '' | downcase
        assign bmp_swatch_any_lookup_key = '|' | append: bmp_swatch_any_key | append: ':'
        if bmp_swatch_override_lookup contains bmp_swatch_any_lookup_key
          assign bmp_swatch_any_hit = true
          break
        endif
        if bmp_swatch_default_lookup contains bmp_swatch_any_lookup_key
          assign bmp_swatch_any_hit = true
          break
        endif
      endfor
    -%}
    {%- if bmp_swatch_any_hit -%}true{%- endif -%}
  {%- else -%}
  {%- liquid
    assign bmp_swatch_value_key = value | strip | replace: '"', '' | downcase
    assign bmp_swatch_lookup_key = '|' | append: bmp_swatch_value_key | append: ':'
    assign bmp_swatch_override_candidate = blank
    assign bmp_swatch_default_candidate = blank

    if bmp_swatch_override_lookup contains bmp_swatch_lookup_key
      assign bmp_swatch_override_matches = bmp_swatch_override_lookup | split: bmp_swatch_lookup_key
      assign bmp_swatch_override_tail = bmp_swatch_override_matches | last
      assign bmp_swatch_override_candidate = bmp_swatch_override_tail | split: '|' | first | strip
    endif

    if bmp_swatch_default_lookup contains bmp_swatch_lookup_key
      assign bmp_swatch_default_matches = bmp_swatch_default_lookup | split: bmp_swatch_lookup_key
      assign bmp_swatch_default_tail = bmp_swatch_default_matches | last
      assign bmp_swatch_default_candidate = bmp_swatch_default_tail | split: '|' | first | strip
    endif

    # Override mode reuses this whole branch but blanks the baked
    # default so only a validated merchant row may emit. An unmatched or
    # invalid override then renders as blank, and the caller falls through
    # to native swatch.color.
    if mode == 'override'
      assign bmp_swatch_default_candidate = blank
    endif
  -%}
  {%- assign bmp_swatch_candidates = bmp_swatch_override_candidate | append: '|' | append: bmp_swatch_default_candidate -%}
  {%- assign bmp_swatch_candidate_rows = bmp_swatch_candidates | split: '|' -%}
  {%- for bmp_swatch_candidate in bmp_swatch_candidate_rows -%}
    {%- liquid
      assign bmp_swatch_candidate = bmp_swatch_candidate | strip_newlines | strip | downcase
      assign bmp_swatch_candidate_length = bmp_swatch_candidate | size
      assign bmp_swatch_without_hashes = bmp_swatch_candidate | remove: '#'
      assign bmp_hash_count = bmp_swatch_candidate_length | minus: bmp_swatch_without_hashes.size
      assign bmp_invalid_chars = bmp_swatch_without_hashes | remove: '0' | remove: '1' | remove: '2' | remove: '3' | remove: '4' | remove: '5' | remove: '6' | remove: '7' | remove: '8' | remove: '9' | remove: 'a' | remove: 'b' | remove: 'c' | remove: 'd' | remove: 'e' | remove: 'f'
      assign bmp_swatch_first_char = bmp_swatch_candidate | slice: 0, 1
      assign bmp_swatch_is_single = false
      assign bmp_swatch_is_split = false

      if bmp_invalid_chars == blank and bmp_swatch_first_char == '#'
        if bmp_hash_count == 1
          if bmp_swatch_candidate_length == 4 or bmp_swatch_candidate_length == 7
            assign bmp_swatch_is_single = true
          endif
        elsif bmp_hash_count == 2
          if bmp_swatch_candidate_length == 8
            assign bmp_swatch_second_hash = bmp_swatch_candidate | slice: 4, 1
            if bmp_swatch_second_hash == '#'
              assign bmp_swatch_is_split = true
              assign bmp_swatch_color_1 = bmp_swatch_candidate | slice: 0, 4
              assign bmp_swatch_color_2 = bmp_swatch_candidate | slice: 4, 4
            endif
          elsif bmp_swatch_candidate_length == 14
            assign bmp_swatch_second_hash = bmp_swatch_candidate | slice: 7, 1
            if bmp_swatch_second_hash == '#'
              assign bmp_swatch_is_split = true
              assign bmp_swatch_color_1 = bmp_swatch_candidate | slice: 0, 7
              assign bmp_swatch_color_2 = bmp_swatch_candidate | slice: 7, 7
            endif
          endif
        endif
      endif
    -%}
    {%- if bmp_swatch_is_single -%}
      {{- bmp_swatch_candidate -}}
      {%- break -%}
    {%- elsif bmp_swatch_is_split -%}
      linear-gradient(135deg, {{ bmp_swatch_color_1 }} 0 50%, {{ bmp_swatch_color_2 }} 50% 100%)
      {%- break -%}
    {%- endif -%}
  {%- endfor -%}
  {%- endif -%}
{%- endif -%}
