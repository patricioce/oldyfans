{%- doc -%}
  Resolves whether an option uses BMP name-based swatches or returns a validated CSS background for one option value.

  @param {string} option_name - Product option name.
  @param {string} [value] - Product option value name to resolve.
  @param {object} [values] - Product option values, required by `option_any`.
  @param {string} [mode] - Use `option_match` to return `true` when the configured option name matches by name alone.
    Use `option_any` to return `true` only when the option matches AND at least one of `values` resolves to a mapped
    row, which is what keeps a fully unmapped option from claiming swatch rendering.
    Use `override` to resolve `value` against the merchant override rows alone: identical hex/split
    validation, but the 241 baked-in defaults never emit, so a caller can rank a merchant row ahead
    of native swatch.color while the defaults stay behind every native resolver. Blank
    when no valid override row exists.

  @example
  {%- render 'bmp-swatch-color-map', option_name: product_option.name, value: product_option_value.name -%}
  {%- render 'bmp-swatch-color-map', option_name: product_option.name, values: product_option.values, mode: 'option_any' -%}
{%- enddoc -%}

{%- liquid
  assign bmp_swatch_enabled = true
  if settings.bmp_swatch_fallback_enabled == false
    assign bmp_swatch_enabled = false
  endif

  assign bmp_swatch_option_match = false
  if bmp_swatch_enabled and option_name != blank
    assign bmp_swatch_option_key = option_name | strip | replace: '"', '' | downcase
    assign bmp_swatch_option_names = settings.bmp_swatch_option_names | default: 'Color,Colour' | split: ','
    for bmp_swatch_configured_option in bmp_swatch_option_names
      assign bmp_swatch_configured_key = bmp_swatch_configured_option | strip | replace: '"', '' | downcase
      if bmp_swatch_configured_key == bmp_swatch_option_key
        assign bmp_swatch_option_match = true
        break
      endif
    endfor
  endif

  # `option_match` answers by name alone and never needs the default map, so it
  # stays free. Every other mode has to build the map, so gate the expensive
  # branch on one precomputed boolean rather than a compound `and`/`or` test —
  # Liquid has no parentheses and evaluates those right-to-left.
  assign bmp_swatch_needs_map = false
  if bmp_swatch_option_match
    if mode == 'option_any'
      assign bmp_swatch_needs_map = true
    elsif value != blank
      assign bmp_swatch_needs_map = true
    endif
  endif
-%}

{%- if mode == 'option_match' -%}
  {%- if bmp_swatch_option_match -%}true{%- endif -%}
{%- elsif bmp_swatch_needs_map -%}
