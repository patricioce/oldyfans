{%- doc -%}
  Renders a default variant picker, used to display the variant picker in the variants block.

  @param {object} product_resource - The product object.
  @param {object} [block] - The block object
  @param {object} section - The section object.
  @param {object} product - The current product object (used to determine selected variant state).
{%- enddoc -%}

{% assign block_settings = block.settings %}

{% liquid
  # Custom styling applies to:
  #   - dropdowns + buttons when variant_style_class == 'custom' (unselected colors)
  #   - buttons only when selected_variant_style_class == 'custom' (selected colors)
  # The 'buttons' label is kept for backwards-compat of the class name.
  assign has_custom_variant_buttons = false
  if block_settings.variant_style_class == 'custom'
    assign has_custom_variant_buttons = true
  endif
  if block_settings.variant_style == 'buttons' and block_settings.selected_variant_style_class == 'custom'
    assign has_custom_variant_buttons = true
  endif
  assign fieldset_index = 0
%}

{% unless product_resource.has_only_default_variant %}
  {% if has_custom_variant_buttons %}
    {% render 'variant-button-custom-styles', block_settings: block_settings, block_id: block.id %}
  {% endif %}
  <variant-picker
    class="variant-picker spacing-style variant-picker--{{ block_settings.alignment }}{% if has_custom_variant_buttons %} variant-picker--custom-{{ block.id }}{% endif %}"
    style="
      {% render 'spacing-style', settings: block_settings %}
       {% if block_settings.option_label_text_color != blank %}
        --variant-option-label-color: rgba({{ block_settings.option_label_text_color.rgba }});
        --variant-option-label-color-subdued: rgba({{ block_settings.option_label_text_color.rgb }} / var(--opacity-subdued-text));
      {% endif %}
    "
    data-section-id="{{ section.id }}"
    data-product-id="{{ product_resource.id }}"
    data-product-handle="{{ product_resource.handle }}"
    data-product-title="{{ product_resource.title | escape }}"
    data-block-id="{{ block.id }}"
    data-product-url="{{ product_resource.url }}"
    ref="mainVariantPicker"
    {% if product.id == product_resource.id %}
      data-template-product-match="true"
    {% endif %}
    {{ block.shopify_attributes }}
    {% if request.visual_preview_mode %}
      data-shopify-visual-preview
    {% endif %}
  >
    <form class="variant-picker__form">
      {%- for product_option in product_resource.options_with_values -%}
        {%- liquid
          assign swatch_count = product_option.values | map: 'swatch' | compact | size
          # BMP-HOOK-START:swatch-name-fallback
          # option_any, not option_match. With a name-only gate an option where
          # NOTHING resolves still became variant_style == 'swatch', so the
          # fieldset carried variant-option--swatches while every value inside it
          # rendered as a pill, and it lost both the native equal-width button
          # class and the per-fieldset width rule below, which are keyed on
          # variant_style == 'buttons'. Requiring one resolvable value keeps that
          # product on Horizon's untouched button rendering instead.
          #
          # Do not write a Liquid tag delimiter inside these comments. Inside a
          # liquid block the first closing delimiter ends the whole block, and
          # every assign after it silently becomes undefined.
          capture bmp_swatch_fallback_option
            render 'bmp-swatch-color-map', option_name: product_option.name, values: product_option.values, mode: 'option_any'
          endcapture
          assign bmp_swatch_fallback_option = bmp_swatch_fallback_option | strip
          if bmp_swatch_fallback_option == 'true'
            assign swatch_count = 1
          endif
          # BMP-HOOK-END:swatch-name-fallback
          assign variant_style = block_settings.variant_style

          if swatch_count > 0 and block_settings.show_swatches
            if block_settings.variant_style == 'dropdown'
              assign variant_style = 'swatch_dropdown'
            else
              assign variant_style = 'swatch'
            endif
          endif

          if variant_style == 'buttons' and settings.variant_button_width == 'equal-width-buttons'
            assign fieldset_id = section.id | append: '-' | append: product_resource.id | append: '-' | append: product_option.name | handleize
            assign option_id_attribute = 'data-option-id="' | append: fieldset_id | append: '"'
            assign longest_value = 0
          endif
        -%}
        {%- comment -%}BMP-HOOK-START:size-required-unselected{%- endcomment -%}
        {%- comment -%}
          Forced size selection: decide whether THIS option is the gated size option.

          A separate {%- liquid -%} tag rather than lines appended inside the
          native one above: the native tag's bytes stay untouched and the hook
          keeps the ordinary block-comment marker form. The `#` line-comment
          form is only for a hook that must sit mid-body
          where the tag cannot be split — appending after the tag closes needs
          no split at all.

          The option name comes from settings.bmp_size_guide_option (D2), the
          same expression blocks/bmp-size-guide.liquid:37 and
          snippets/bmp-size-guide-trigger.liquid:37 already use, so one naming
          setting serves the size guide and the gate and the two can never
          disagree about which option is the size.

          The nil-safe read is the bmp-card-hover.liquid precedent: an
          unmaterialised checkbox reads as nil, the schema default is true (D3),
          so nil must mean ON here AND in
          snippets/bmp-size-required-state.liquid — otherwise the render half
          and the enforcement half disagree about whether the gate is on, for
          exactly the stores that never opened the Theme Editor. Written as an
          explicit `== false` test rather than a truthiness check, because in
          Liquid nil is falsy and `| default:` treats false as absent — both
          would silently invert the default.

          `values.size > 1` is load-bearing, not defensive: a size option with
          ONE value offers nothing to choose, so a gated one could never be
          satisfied by interaction and Layer 2 would keep the hidden
          input[name="id"] disabled forever — add-to-cart broken outright on
          that product. The same condition guards the enforcement half.
        {%- endcomment -%}
        {%- liquid
          assign bmp_size_option = settings.bmp_size_guide_option | strip | default: 'Size'
          assign bmp_size_required = true
          if settings.bmp_size_required == false
            assign bmp_size_required = false
          endif
          assign bmp_size_gate = false
          if bmp_size_required and product_option.name == bmp_size_option and product_option.values.size > 1
            assign bmp_size_gate = true
          endif

          # The unselected treatment must not claim a value nobody chose. The
          # pdp-option-value hook prints product_option.selected_value
          # in every legend, and Liquid resolves that to the FIRST AVAILABLE
          # value on a cold load — suppressing the radio's `checked` does not
          # change it. So a gated product would render "Size: XS" directly
          # above a fieldset where nothing is selected: the exact contradiction
          # this feature exists to remove, and worse than stock, which at
          # least agreed with itself.
          #
          # Conditioned on selected_variant being blank as well, because a
          # `?variant=` request IS a choice (D7 signal 1) — a shared deep link,
          # or simply a reload after picking (Horizon pushes the variant into
          # the URL). Since the cta-prompt follow-up this flag keys the WHOLE
          # unselected treatment — legend value, radio `checked`, dropdown
          # placeholder — so a satisfied arrival renders the size marked and
          # never shows a normal Add to cart over an unselected size row.
          #
          # The reason `checked` was once suppressed on bmp_size_gate alone:
          # a SECTION render resolved from a partial option_values list (a
          # colour click while no size is chosen) also arrives with
          # selected_variant set, for a size nobody chose. Liquid cannot tell
          # that request from a real ?variant= page load, so the enforcement
          # moved to the client: assets/bmp-size-required.js#onProductSelect
          # re-empties a gated fieldset after the morph whenever its pre-fetch
          # snapshot was empty and the gate is still unsatisfied.
          assign bmp_size_hide_value = false
          if bmp_size_gate and product_resource.selected_variant == blank
            assign bmp_size_hide_value = true
          endif
        -%}
        {%- comment -%}BMP-HOOK-END:size-required-unselected{%- endcomment -%}

        {%- if product_option.values.size == 1 and variant_style != 'swatch' -%}
          <div
            class="variant-option"
            data-testid="variant-option-single"
          >
            {{- product_option.name | escape -}}
            {% comment %}BMP-HOOK-START:pdp-option-value{% endcomment %}:{% comment %}BMP-HOOK-END:pdp-option-value{% endcomment %}
            <span
              class="variant-option__swatch-value"
              data-testid="variant-option-single-value"
            >
              {{- product_option.selected_value -}}
            </span>
          </div>
        {%- elsif variant_style == 'swatch' or block_settings.variant_style == 'buttons' -%}
          <fieldset
            class="variant-option variant-option--buttons{% if variant_style == 'swatch' %} variant-option--swatches{% else %} variant-option--{{ settings.variant_button_width }}{% endif %}"
            data-fieldset-index="{{ fieldset_index }}"
            ref="fieldsets[]"
            {{ option_id_attribute }}
            {% comment %}BMP-HOOK-START:size-required-unselected{% endcomment %}{% if bmp_size_gate %}data-bmp-size-fieldset="true"{% endif %}{% comment %}BMP-HOOK-END:size-required-unselected{% endcomment %}
          >
            <legend>
              {{ product_option.name | escape -}}
              {%- comment -%}BMP-HOOK-START:pdp-option-value{%- endcomment -%}
              {{- ': ' -}}
              {%- comment -%}BMP-HOOK-END:pdp-option-value{%- endcomment -%}
              {%- comment -%}BMP-HOOK-START:size-required-unselected{%- endcomment -%}
              {%- unless bmp_size_hide_value -%}
              {%- comment -%}BMP-HOOK-END:size-required-unselected{%- endcomment -%}
              {%- if variant_style == 'swatch' -%}
                <span class="variant-option__swatch-value">{{ product_option.selected_value }}</span>
              {%- endif %}
              {%- comment -%}BMP-HOOK-START:pdp-option-value{%- endcomment -%}
              {%- unless variant_style == 'swatch' -%}
                <span class="variant-option__swatch-value">{{ product_option.selected_value }}</span>
              {%- endunless -%}
              {%- comment -%}BMP-HOOK-END:pdp-option-value{%- endcomment -%}
              {%- comment -%}BMP-HOOK-START:size-required-unselected{%- endcomment -%}
              {%- endunless -%}
              {%- comment -%}BMP-HOOK-END:size-required-unselected{%- endcomment -%}
              {%- comment -%}BMP-HOOK-START:pdp-option-value{%- endcomment -%}
              {%- render 'bmp-size-guide-trigger', option_name: product_option.name, product_id: product_resource.id, product_url: product_resource.url -%}
              {%- comment -%}BMP-HOOK-END:pdp-option-value{%- endcomment -%}
            </legend>
            {%- for product_option_value in product_option.values -%}
              {% if product_option_value.size > longest_value and option_id_attribute %}
                {% assign longest_value = product_option_value.size %}
              {% endif %}
              {%- comment -%}BMP-HOOK-START:swatch-name-fallback{%- endcomment -%}
              {%- comment -%}
                The featured-media resolution below is Horizon's, moved up out of
                the swatch branch: the circle-vs-pill decision now has to happen
                before that branch, and so does the --has-swatch class on the
                label — a pill carrying --has-swatch loses its styling, because
                assets/bmp-styles.css targets :not(--has-swatch).

                bmp_render_swatch mirrors ALL THREE of swatch.liquid's native
                resolvers, not just the map. A product mid-unlink can still carry
                a real metaobject swatch, and a store with show_variant_image on
                can carry a variant image. Testing the map alone would send both
                to the pill branch and destroy a circle that renders correctly
                today. An override-mode probe runs first; a
                validated merchant row is threaded as bmp_override and outranks
                native swatch.color inside the renderer.

                The map render is gated on variant_style so button-style options
                (Size, Material) never pay for it.
              {%- endcomment -%}
              {%- liquid
                assign featured_media = product_option_value.variant.featured_media

                # If the variant has no featured media, and we have a combined listing product, then fall back to
                # using the featured media of the child product that is linked to this option value.
                if featured_media == blank and product_option_value.product_url
                  assign featured_media = product_option_value.variant.product.featured_media
                endif

                assign bmp_swatch_hex = ''
                assign bmp_swatch_override_hex = ''
                assign bmp_render_swatch = false
                if variant_style == 'swatch'
                  # Probe the merchant override rows first. A validated
                  # row must beat native swatch.color, so it cannot ride in
                  # bmp_resolved — the renderer reads that only after every
                  # native resolver. The stripped result (possibly '') is
                  # threaded as bmp_override so swatch.liquid never probes
                  # twice. An empty textarea means no row can exist.
                  if settings.bmp_swatch_value_list != blank
                    capture bmp_swatch_override_hex
                      render 'bmp-swatch-color-map', option_name: product_option.name, value: product_option_value.name, mode: 'override'
                    endcapture
                    assign bmp_swatch_override_hex = bmp_swatch_override_hex | strip
                  endif
                  if bmp_swatch_override_hex != blank
                    assign bmp_swatch_hex = bmp_swatch_override_hex
                  else
                    capture bmp_swatch_hex
                      render 'bmp-swatch-color-map', option_name: product_option.name, value: product_option_value.name
                    endcapture
                    assign bmp_swatch_hex = bmp_swatch_hex | strip
                  endif

                  if settings.show_variant_image and featured_media != blank
                    assign bmp_render_swatch = true
                  elsif product_option_value.swatch.image != blank
                    assign bmp_render_swatch = true
                  elsif product_option_value.swatch.color != blank
                    assign bmp_render_swatch = true
                  elsif bmp_swatch_hex != blank
                    assign bmp_render_swatch = true
                  endif
                endif
              -%}
              {%- comment -%}BMP-HOOK-END:swatch-name-fallback{%- endcomment -%}
              <label
                class="variant-option__button-label{% comment %}BMP-HOOK-START:swatch-name-fallback{% endcomment %}{% if bmp_render_swatch %}{% comment %}BMP-HOOK-END:swatch-name-fallback{% endcomment %} variant-option__button-label--has-swatch{% endif %}"
              >
                <input
                  type="radio"
                  name="{{ product_option.name | escape }}-{{ block.id }}-{{ product_resource.id }}"
                  value="{{ product_option_value | escape }}"
                  aria-label="{{ product_option_value.name | escape }}{% if product_option_value.available == false %} - {{ 'products.product.sold_out' | t }}{% endif %}"
                  {% if product_option_value.available == false %}
                    aria-disabled="true"
                  {% endif %}
                  data-previous-checked="false"
                  data-fieldset-index="{{ fieldset_index }}"
                  data-input-index="{{ forloop.index0 }}"
                  data-input-id="{{ product_option.position }}-{{ forloop.index0 }}"
                  data-option-name="{{ product_option.name | escape }}"
                  data-option-value-id="{{ product_option_value.id }}"
                  data-option-available="{{ product_option_value.available }}"
                  data-connected-product-url="{{ product_option_value.product_url }}"
                  {% if product_option_value.variant.id %}
                    data-variant-id="{{ product_option_value.variant.id }}"
                  {% endif %}
                  {%- comment -%}BMP-HOOK-START:size-required-unselected{%- endcomment -%}
                  {%- if bmp_size_hide_value -%}
                    data-current-checked="false"
                  {%- else -%}
                  {%- comment -%}BMP-HOOK-END:size-required-unselected{%- endcomment -%}
                  {% if product_option_value.selected %}
                    data-current-checked="true"
                    checked
                  {% else %}
                    data-current-checked="false"
                  {% endif %}
                  {%- comment -%}BMP-HOOK-START:size-required-unselected{%- endcomment -%}
                  {%- endif -%}
                  {%- comment -%}BMP-HOOK-END:size-required-unselected{%- endcomment -%}
                >
                {%- comment -%}BMP-HOOK-START:swatch-name-fallback{%- endcomment -%}
                {% if bmp_render_swatch %}
                  {%- comment -%}BMP-HOOK-END:swatch-name-fallback{%- endcomment -%}
                  {%- comment -%}BMP-HOOK-START:swatch-name-fallback{%- endcomment -%}
                  {% render 'swatch',
                    swatch: product_option_value.swatch,
                    variant_image: featured_media,
                    value: product_option_value.name,
                    option_name: product_option.name,
                    bmp_resolved: bmp_swatch_hex,
                    bmp_override: bmp_swatch_override_hex,
                    mode: 'unscaled'
                  %}
                  {%- comment -%}BMP-HOOK-END:swatch-name-fallback{%- endcomment -%}
                {% else %}
                  {% if product_option_value.available == true %}
                    <span
                      class="variant-option__button-label__pill"
                      data-key="variant-option-pill"
                    ></span>
                  {% endif %}
                  <span
                    class="variant-option__button-label__text"
                    data-key="variant-option-text"
                  >
                    {{- product_option_value | escape -}}
                  </span>
                {% endif %}
                {% render 'strikethrough-variant', product_option: product_option_value %}
              </label>
            {%- endfor -%}
            {% if option_id_attribute %}
              {% style %}
                [data-option-id="{{ fieldset_id }}"] {
                  --variant-ch: {{ longest_value | times: 0.65 }}em;
                }
              {% endstyle %}
            {% endif %}
          </fieldset>
          {%- assign fieldset_index = fieldset_index | plus: 1 -%}
        {%- elsif block_settings.variant_style == 'dropdowns' -%}
          {%
            # There is an opportunity to build a custom select component that will allow us to style the select element further (animation for dropdown, swatches shown in the dropdown options, etc)
            # It's too bad as it mean rebuilding baked in behaviours but I think we've already done that for the locale selectors
            # in dawn. So it might mean more time spent in setting it up but worth it for future updates/styling.
          %}
          {% liquid
            assign property_being_updated = false
            if settings.variant_swatch_width != settings.variant_swatch_height
              assign property_being_updated = true
              # (original width / original height) x new height (20px at the moment) = new width
              assign new_width = settings.variant_swatch_width | times: 1.0 | divided_by: settings.variant_swatch_height | times: 20
            endif
          %}

          <div class="variant-option variant-option--dropdowns">
            <label for="Option-{{ block.id }}-{{ forloop.index0 }}">{{ product_option.name | escape }}</label>
            <div
              class="variant-option__select-wrapper"
              style="
                {%- if property_being_updated  -%}
                  --variant-picker-swatch-width: clamp(10px,{{ new_width }}px, 50px);
                {%- endif -%}
              "
            >
              <select
                id="Option-{{ block.id }}-{{ forloop.index0 }}"
                name="options[{{ product_option.name | escape }}]"
                class="variant-option__select"
              >
                {%- comment -%}BMP-HOOK-START:size-required-unselected{%- endcomment -%}
                {%- comment -%}
                  A <select> with no selected option selects its FIRST
                  one automatically, so omitting `selected="selected"` below is
                  not enough on its own — the placeholder is what actually
                  leaves the dropdown unchosen.

                  Deliberately NOT `required` on the <select>. `required` plus a
                  selected empty option makes the form invalid, which returns
                  AddToCartComponent.handleClick early at its own
                  `form?.checkValidity()` (assets/product-form.js:73) and hands
                  the shopper the browser's native validation bubble — a
                  fourth, unstyled presentation the design does not ask for.
                  v1.1.5 shipped `required` for this reason and its own guard
                  never got to run. The gate provides the feedback instead.
                {%- endcomment -%}
                {%- if bmp_size_hide_value -%}
                  <option value="" selected disabled>{{ 'bmp.content.bmp_size_required_prompt' | t }}</option>
                {%- endif -%}
                {%- comment -%}BMP-HOOK-END:size-required-unselected{%- endcomment -%}
                {%- for product_option_value in product_option.values -%}
                  <option
                    value="{{ product_option_value | escape }}"
                    data-input-id="{{ product_option.position }}-{{ forloop.index0 }}"
                    data-option-name="{{ product_option.name | escape }}"
                    data-option-value-id="{{ product_option_value.id }}"
                    data-variant-id="{{ product_option_value.variant.id }}"
                    data-connected-product-url="{{ product_option_value.product_url }}"
                    {%- comment -%}BMP-HOOK-START:size-required-unselected{%- endcomment -%}
                    {%- unless bmp_size_hide_value -%}
                    {%- comment -%}BMP-HOOK-END:size-required-unselected{%- endcomment -%}
                    {% if product_option_value.selected %}
                      selected="selected"
                    {% endif %}
                    {%- comment -%}BMP-HOOK-START:size-required-unselected{%- endcomment -%}
                    {%- endunless -%}
                    {%- comment -%}BMP-HOOK-END:size-required-unselected{%- endcomment -%}
                  >
                    {% if product_option_value.available == false %}
                      {{ product_option_value | escape }} - {{ 'content.unavailable' | t }}
                    {% else %}
                      {{ product_option_value | escape }}
                    {% endif %}
                  </option>
                {%- endfor -%}
              </select>
              <svg
                aria-hidden="true"
                focusable="false"
                class="icon icon-caret"
                viewBox="0 0 10 6"
              >
                {%- render 'icon', icon: 'caret' -%}
              </svg>
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}

      <script type="application/json">
        {{ product_resource.selected_or_first_available_variant | json }}
      </script>
    </form>
  </variant-picker>
{% endunless %}

{% render 'swatch-styles' %}
{% render 'variant-picker-styles' %}
