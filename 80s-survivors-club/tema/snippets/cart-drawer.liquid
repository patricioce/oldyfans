{% doc %}
  Renders reusable cart drawer markup for both initial page loads and Section Rendering API responses.

  @param {boolean} [render_wrapper] - When true, wraps the drawer in the section wrapper that the Section Rendering API adds automatically.
{% enddoc %}

{%- liquid
  assign render_wrapper = render_wrapper | default: true, allow_false: true
-%}

{%- if settings.cart_type == 'drawer' and template.name != 'cart' -%}
  {% if render_wrapper %}
    <div
      id="shopify-section-cart-drawer-section"
      class="shopify-section"
    >
  {% endif %}

  <script
    type="module"
    src="{{ 'cart-drawer.js' | asset_url }}"
    fetchpriority="low"
  ></script>
  {%- comment -%}BMP-HOOK-START:cart-drawer-script{%- endcomment -%}
  {%- comment -%}script_only render loads the announcements module once, like the native loader above — Section Rendering morphs never re-execute scripts, so the module must not depend on re-execution{%- endcomment -%}
  {% render 'bmp-cart-announcements', script_only: true %}
  {%- comment -%}BMP-HOOK-END:cart-drawer-script{%- endcomment -%}

  {% capture empty_cart_drawer_content %}
    <div
      class="cart-drawer__content"
      aria-label="{{ 'accessibility.cart' | t }}"
    >
      <h2
        class="theme-drawer__title h4"
        id="cart-drawer-heading"
      >
        {{ 'content.your_cart_is_empty' | t }}
      </h2>

      <div class="cart-drawer__items">
        {% render 'cart-products', force_empty: true, context: 'drawer' %}
      </div>
    </div>
  {% endcapture %}

  <theme-drawer
    id="cart-drawer"
    data-skip-node-update
    {% comment %}BMP-HOOK-START:cart-drawer-no-persist{% endcomment %}no-persist{% comment %}BMP-HOOK-END:cart-drawer-no-persist{% endcomment %}
  >
    <dialog
      ref="panel"
      class="theme-drawer__dialog color-custom-drawer"
      aria-labelledby="cart-drawer-heading"
      cart-summary-sticky="true"
    >
      <cart-drawer-component
        {% if settings.auto_open_cart_drawer and template.name != 'cart' %}
          auto-open
        {% endif %}
      >
        <template id="empty-cart-template">
          {{ empty_cart_drawer_content }}
        </template>

        <div
          class="cart-drawer__inner{% if cart.empty? %} cart-drawer--empty{% endif %}"
          data-hydration-key="cart-drawer-inner"
        >
          {%- if cart.empty? -%}
            <div class="theme-drawer__header">
              <button
                on:click="#cart-drawer/close"
                class="theme-drawer__close-button cart-drawer__close-button--empty"
                type="button"
                aria-label="{{ 'actions.close' | t }}"
              >
                <span class="svg-wrapper">
                  {{- 'icon-close.svg' | inline_asset_content -}}
                </span>
              </button>
            </div>
          {%- else -%}
            {% capture cart_badge_html %}
              <span
                class="theme-drawer__badge{% if cart.item_count == 0 %} visually-hidden{% endif %}"
                aria-hidden="true"
                {% if cart.item_count <= 99 %}
                  data-maintain-ratio
                {% endif %}
              >
                {{- cart.item_count -}}
              </span>
              {% if cart.item_count > 0 %}
                <span class="visually-hidden">
                  {{ 'accessibility.cart_count' | t }}: {{ cart.item_count }}
                </span>
              {% endif %}
            {% endcapture %}
            {% assign cart_drawer_title = 'Your cart' %}
            {% render 'theme-drawer-header',
              title: cart_drawer_title,
              drawer_id: 'cart-drawer',
              heading_id: 'cart-drawer-heading',
              title_append: ''
            %}
          {%- endif -%}

          {% capture cart_items_children %}
            {%- if cart.empty? -%}
              {{ empty_cart_drawer_content }}
            {%- else -%}
              {%- comment -%}BMP-HOOK-START:cart-drawer-progress{%- endcomment -%}
              {% render 'bmp-free-shipping-bar' %}
              {%- comment -%}BMP-HOOK-END:cart-drawer-progress{%- endcomment -%}
              <scroll-hint
                class="cart-drawer__content"
                aria-label="{{ 'accessibility.cart' | t }}"
              >
                <scroll-hint class="cart-drawer__items">
                  <div class="bmp-cart-head" aria-hidden="true">
                    <span>Product</span>
                    <span>Total</span>
                  </div>
                  {% render 'cart-products', context: 'drawer' %}
                </scroll-hint>

                <div class="cart-drawer__summary">
                  {% render 'cart-summary', section_id: 'cart-drawer-section' %}
                </div>
              </scroll-hint>
              {%- comment -%}BMP-HOOK-START:cart-drawer-announcements{%- endcomment -%}
              {%- comment -%}Sibling AFTER the scroll container, not inside it: scroll-hint masks its own bottom edge while scrollable (assets/scrolling.js) and the sticky summary sits at bottom:0 — inside, the announcements would render faded and underneath it. Still inside the cart-items-component capture so Section Rendering morphs re-render it.{%- endcomment -%}
              {% render 'bmp-cart-announcements' %}
              {%- comment -%}BMP-HOOK-END:cart-drawer-announcements{%- endcomment -%}
            {%- endif -%}
          {% endcapture %}
          {% render 'cart-items-component',
            children: cart_items_children,
            is_drawer: true,
            section_id: 'cart-drawer-section'
          %}
        </div>
      </cart-drawer-component>
    </dialog>
  </theme-drawer>

  {% if render_wrapper %}
    </div>
  {% endif %}
{%- endif -%}

{% stylesheet %}
  cart-drawer-component {
    --cart-drawer-padding: var(--theme-drawer-padding);
    --font-paragraph--line-height: 1;
    display: contents;
  }

  .cart-drawer__inner {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
  }

  .cart-drawer__inner > .cart-items-component {
    flex: 1;
    min-height: 0;
    height: auto;
  }

  .cart-drawer__content {
    display: flex;
    flex-direction: column;
    padding: 0;
    background-color: var(--color-background);
    flex-grow: 1;
    overflow-y: auto;
  }

  .cart-drawer__items {
    display: flex;
    flex-direction: column;
    padding-inline: var(--cart-drawer-padding);
    overflow-y: auto;
  }

  .cart-drawer__items .cart-items__table-row {
    padding-bottom: var(--gap-xl);
    border-bottom: var(--style-border-width) solid rgb(var(--color-foreground-rgb) / var(--opacity-10-25));
    margin-bottom: var(--gap-xl);
  }

  .cart-drawer__items .cart-items__table-row:has(+ .cart-items__nested-line) {
    border-bottom: none;
    margin-bottom: 0;
  }

  .cart-drawer__items .cart-items__table-row:last-child {
    border-bottom: none;
    padding-block-end: 0;
    margin-block-end: 0;
  }

  .cart-drawer__close-button--empty {
    margin-inline-start: auto;
  }

  .cart-drawer__summary {
    --cart-drawer-summary-padding: var(--padding-lg);

    position: sticky;
    bottom: 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--gap-xl);
    padding: var(--cart-drawer-summary-padding);
    margin-top: auto;
    background-color: var(--color-background);
    /* stylelint-disable-next-line color-named */
    mask-image: linear-gradient(to bottom, transparent, black var(--cart-drawer-summary-padding));

    @media screen and (min-width: 750px) {
      --cart-drawer-summary-padding: var(--padding-2xl);
    }
  }

  .theme-drawer__dialog[cart-summary-sticky='false'] .cart-drawer__summary {
    position: static;
    mask-image: none;
  }

  .theme-drawer__dialog[cart-summary-sticky='false'] .cart-drawer__items {
    overflow: unset;
  }

  .cart-actions summary {
    padding-inline: 0;
    padding-block: var(--padding-sm);
    line-height: 1.2;
    min-height: var(--minimum-touch-target);
  }

  .cart-drawer__summary .cart__summary-totals:not(:has(.cart__subtotal-container:empty)) {
    border-block-start: var(--style-border-width) solid rgb(var(--color-foreground-rgb) / var(--opacity-10-25));
    padding-block-start: var(--padding-2xl);
  }

  .cart-drawer__summary .cart-note {
    @media screen and (min-width: 750px) {
      margin-block-start: var(--margin-3xs);
    }
  }

  .cart-drawer--empty .cart-drawer__content {
    text-align: center;
    align-items: center;
    justify-content: center;
    min-height: auto;
  }

  .cart-drawer--empty .cart-drawer__items {
    padding-inline: 0;
  }

  cart-drawer-component:not(:has(.cart-form)) .cart-drawer__content {
    text-align: center;
    align-items: center;
    justify-content: center;
  }

  cart-drawer-component:not(:has(.cart-form)) .cart-drawer__items {
    padding-inline: 0;
  }

  @media screen and (prefers-reduced-motion: no-preference) {
    html:active-view-transition-type(empty-cart-drawer) {
      .theme-drawer__close-button {
        view-transition-name: cart-drawer-close-button;
      }
    }
  }

  :active-view-transition {
    .cart-drawer__header,
    .cart-drawer__content {
      background: transparent;
    }
  }

  /* ===== Carrito estilo referencia ===== */
  .cart-drawer__inner .theme-drawer__badge { display: none; }

  .cart-drawer__inner .theme-drawer__close-button {
    background: none;
    border: 0;
    box-shadow: none;
  }

  .cart-drawer__inner .theme-drawer__title {
    font-weight: 800;
  }

  .bmp-cart-head {
    display: flex;
    justify-content: space-between;
    padding-block: var(--padding-md);
    margin-block-end: var(--margin-xl);
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgb(var(--color-foreground-rgb) / 0.65);
    border-block: 1px solid rgb(var(--color-foreground-rgb) / 0.14);
  }

  .cart-drawer__inner tbody .cart-items__table-row.cart-items__table-row--full-width-variants,
  .cart-drawer__inner tbody .cart-items__table-row {
    grid-template-columns: 100px minmax(0, 1fr) auto !important;
    grid-template-areas:
      'media details price'
      'media unit_price unit_price'
      'media variants variants'
      'media quantity quantity'
      'media error error' !important;
    column-gap: var(--gap-lg);
    row-gap: 4px;
    border-bottom: 0 !important;
  }

  .cart-drawer__inner .cart-items__media-image {
    width: 100px;
    height: auto;
    border: 0;
    border-radius: 0;
  }

  .cart-drawer__inner .cart-items__title {
    font-weight: 800;
    font-size: 1.05rem;
    line-height: 1.25;
    text-decoration: none;
    color: rgb(var(--color-foreground-rgb)) !important;
  }

  .cart-drawer__inner .cart-items__unit-price-wrapper {
    font-size: 1rem;
  }

  .cart-drawer__inner .cart-items__unit-price-wrapper s {
    margin-right: 6px;
    font-size: 0.85em;
    opacity: 0.6;
  }

  .cart-drawer__inner .cart-items__unit-price-wrapper span:not(.visually-hidden) {
    color: inherit;
    font-weight: 400;
  }

  .cart-drawer__inner .cart-items__variants {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .cart-drawer__inner .cart-items__variant {
    display: flex;
    gap: 0.35em;
    color: rgb(var(--color-foreground-rgb) / 0.75);
  }

  .cart-drawer__inner .cart-items__variant dt.visually-hidden {
    position: static !important;
    width: auto !important;
    height: auto !important;
    margin: 0 !important;
    overflow: visible !important;
    clip: auto !important;
    clip-path: none !important;
    white-space: nowrap;
  }

  .cart-drawer__inner .cart-items__price {
    display: block !important;
    text-align: end;
    font-weight: 700;
    font-size: 1.05rem;
  }

  .cart-drawer__inner .cart-items__quantity-controls {
    display: flex;
    align-items: center;
    gap: var(--gap-md);
    margin-block-start: var(--margin-sm);
  }

  .cart-drawer__inner .quantity-selector {
    width: 140px;
    height: 46px;
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.35);
    border-radius: 0;
    background: transparent !important;
  }

  .cart-drawer__inner .quantity-selector button.button.quantity-minus,
  .cart-drawer__inner .quantity-selector button.button.quantity-plus {
    background: transparent !important;
    background-color: transparent !important;
    color: var(--color-foreground) !important;
    border-color: transparent !important;
    border-radius: 0;
  }

  .cart-drawer__inner button.button.cart-items__remove {
    background: transparent !important;
    background-color: transparent !important;
    border: 0 !important;
    color: #e73123 !important;
    box-shadow: none;
  }

  .cart-drawer__summary .cart-totals__total-label {
    font-weight: 800;
  }

  .cart-drawer__summary .cart-totals__total-value {
    font-size: 1.9rem;
    font-weight: 700;
  }

  .cart-drawer__summary .cart__checkout-button {
    border-radius: 12px;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  /* ---- ajustes finos vs referencia ---- */
  .cart-drawer__inner .theme-drawer__close-button {
    --private-button-size: 48px;
  }

  .cart-drawer__inner .theme-drawer__close-button .svg-wrapper,
  .cart-drawer__inner .theme-drawer__close-button svg {
    width: 34px;
    height: 34px;
  }

  .cart-drawer__inner .theme-drawer__close-button svg {
    --icon-stroke-width: 1px;
  }

  /* Scroll estable en el carrito (evita que la lista 'baile' en celular) */
  .cart-drawer__content,
  .cart-drawer__items {
    overflow-x: hidden;
    overscroll-behavior: contain;
  }

  .cart-drawer__items {
    -webkit-overflow-scrolling: touch;
    touch-action: pan-y;
  }

  .cart-drawer__inner .bmp-free-shipping-bar {
    border-block-start: 1px solid rgb(var(--color-foreground-rgb) / 0.14);
    margin-block-start: var(--margin-sm);
  }

  .cart-drawer__summary .cart-totals__total-value {
    font-size: 1.6rem !important;
    font-weight: 400 !important;
    color: rgb(var(--color-foreground-rgb) / 0.6);
  }

  .cart-drawer__inner .quantity-selector {
    width: 156px;
    height: 47px;
  }

  .cart-drawer__inner .cart-items__quantity-controls {
    margin-block-start: 2px;
  }

  #cart-drawer .cart-items__quantity-controls {
    flex-direction: column;
    align-items: flex-start;
    width: 100%;
    max-width: 100%;
    gap: 8px;
  }

  #cart-drawer .cart-items__quantity-controls .quantity-selector {
    flex: none;
    width: min(156px, 100%);
  }

  #cart-drawer button.button.cart-items__remove {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 44px;
    height: 44px;
    color: #e73123 !important;
  }

  @media (max-width: 989px) {
    #cart-drawer .theme-drawer__dialog {
      --theme-drawer-width: 90vw;
      width: var(--theme-drawer-width);
      max-width: 90vw;
    }

    #cart-drawer .theme-drawer__dialog::backdrop {
      background: rgb(0 0 0 / 0.45);
    }

    #cart-drawer .cart-items__table-row {
      --cart-mobile-media-width: clamp(60px, 20vw, 100px);
      grid-template-columns: var(--cart-mobile-media-width) minmax(0, 1fr) auto !important;
    }

    #cart-drawer .cart-items__media-image {
      width: clamp(60px, 20vw, 100px);
    }
  }
{% endstylesheet %}
