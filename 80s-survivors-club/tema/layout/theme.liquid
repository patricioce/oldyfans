<!-- Mobile: Title + Rating above product photo -->
<style>
  @media screen and (max-width: 749px) {
    .bmp-mobile-title-rating-wrap {
      margin-bottom: -32px;
    }
    .bmp-mobile-title-rating-wrap > [class*="__product_title_nT77dF"] {
      margin-bottom: 4px;
    }
  }
</style>
<script>
  (function () {
    if (!window.location.pathname.includes('/products/')) return;

    var mq = window.matchMedia('(max-width: 749px)');
    var titleEl, reviewEl, gridEl, wrapper, titleAnchor, reviewAnchor, titleParent, reviewParent, moved = false;

    function init() {
      titleEl = document.querySelector('[class*="__product_title_nT77dF"]');
      reviewEl = document.querySelector('[id$="__loox_reviews_loox_trust_badge_yMQhFR"]');
      gridEl = document.querySelector('product-component');
      if (!titleEl || !reviewEl || !gridEl) return false;
      titleAnchor = titleEl.nextSibling;
      titleParent = titleEl.parentNode;
      reviewAnchor = reviewEl.nextSibling;
      reviewParent = reviewEl.parentNode;
      wrapper = document.createElement('div');
      wrapper.className = 'bmp-mobile-title-rating-wrap';
      return true;
    }

    function applyLayout(isMobile) {
      if (!titleEl && !init()) return;

      if (isMobile && !moved) {
        gridEl.parentNode.insertBefore(wrapper, gridEl);
        wrapper.appendChild(titleEl);
        wrapper.appendChild(reviewEl);
        moved = true;
      } else if (!isMobile && moved) {
        titleParent.insertBefore(titleEl, titleAnchor);
        reviewParent.insertBefore(reviewEl, reviewAnchor);
        wrapper.remove();
        moved = false;
      }
    }

    function run() {
      applyLayout(mq.matches);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', run);
    } else {
      run();
    }

    if (mq.addEventListener) {
      mq.addEventListener('change', function (e) { applyLayout(e.matches); });
    }
  })();
</script>


