    <script>
      (function () {

        const DISCOUNT = 0.30;

        function parsePrice(text) {

          if (!text) return null;

          const clean = text
            .replace(/,/g, '')
            .replace(/[^\d.]/g, '');

          const number = parseFloat(clean);

          return isNaN(number) ? null : number;
        }

        function formatUSD(value) {

          return new Intl.NumberFormat('en-US', {
            style: 'currency',
            currency: 'USD'
          }).format(value);

        }

        function applyFakeDiscount() {
          return; /* desactivado: ahora el precio real es $30 con compare-at $42.85 */

          const selectors = [
            '.price',
            '.price-item',
            '.product-price',
            '.money',
            '.price__regular',
            '.price__sale',
            '.card-information__text',
            '[data-product-price]',
            '.product__price',
            '.product-single__price'
          ];

          const elements =
            document.querySelectorAll(selectors.join(','));

          elements.forEach(el => {

            if (el.dataset.fakeSaleApplied === 'true') return;

            const text = el.innerText?.trim();

            if (!text) return;

            if (el.querySelector('.fake-sale-wrapper')) return;

            const originalPrice = parsePrice(text);

            if (!originalPrice) return;

            const discountedPrice =
              Math.round(originalPrice * (1 - DISCOUNT) * 100 + 0.0001) / 100;

            el.dataset.fakeSaleApplied = 'true';

            el.innerHTML = `
              <span class="fake-sale-wrapper">
                <span class="fake-sale-original">
                  ${formatUSD(originalPrice)}
                </span>

                <span class="fake-sale-new">
                  ${formatUSD(discountedPrice)}
                </span>
              </span>
            `;

          });

        }

        document.addEventListener('DOMContentLoaded', () => {

          applyFakeDiscount();

          const observer = new MutationObserver(() => {
            applyFakeDiscount();
          });

          observer.observe(document.body, {
            childList: true,
            subtree: true
          });

        });

      })();
    </script>


