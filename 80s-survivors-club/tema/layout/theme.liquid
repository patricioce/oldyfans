    <!-- Money Back Guarantee -->
    <script>
      (function () {

        function addGuaranteeBadge() {

          if (
            !window.location.pathname.includes('/products/')
          ) return;

          const addToCart =
            document.querySelector(
              '[data-testid="standalone-add-to-cart"]'
            );

          if (!addToCart) return;

          if (
            document.querySelector(
              '.shc-guarantee-badge'
            )
          ) return;

          const badge =
            document.createElement('div');

          badge.className =
            'shc-guarantee-badge';

          badge.innerHTML = `
            <span
              class="shc-guarantee-check"
              aria-hidden="true"
            >
              <svg
                viewBox="0 0 24 24"
                width="22"
                height="22"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path
                  fill="#304128"
                  d="M12 1.5l2.36 1.78 2.94-.31 1.27 2.67 2.67 1.27-.31 2.94L22.5 12l-1.78 2.36.31 2.94-2.67 1.27-1.27 2.67-2.94-.31L12 22.5l-2.36-1.78-2.94.31-1.27-2.67-2.67-1.27.31-2.94L1.5 12l1.78-2.36-.31-2.94 2.67-1.27 1.27-2.67 2.94.31L12 1.5z"
                ></path>

                <path
                  d="M7.5 12.3l3 3 6-6"
                  stroke="#ffffff"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  fill="none"
                ></path>
              </svg>
            </span>

<span class="shc-guarantee-text">
  <strong>Less than 1% of customers use our <a href="https://oldyfans.store/policies/refund-policy" style="color: inherit; text-decoration: underline;">30-day money-back guarantee</a>.</strong>
</span>
          `;

          let anchor = addToCart.parentNode.parentNode;

          const trustShippingText = [...document.querySelectorAll('*')].find(
            function (e) {
              return e.children.length === 0 && e.textContent.trim() === 'Fast Shipping';
            }
          );

          if (trustShippingText) {

            const ancestorsOfButton = [];
            let a = addToCart;
            while (a) { ancestorsOfButton.push(a); a = a.parentElement; }
            const ancestorSet = new Set(ancestorsOfButton);

            let common = null;
            let b = trustShippingText;
            while (b) { if (ancestorSet.has(b)) { common = b; break; } b = b.parentElement; }

            if (common) {
              let child = trustShippingText;
              while (child.parentElement && child.parentElement !== common) {
                child = child.parentElement;
              }
              if (child.parentElement === common) {
                anchor = child;
              }
            }

          }

          anchor.insertAdjacentElement(
            'afterend',
            badge
          );

        }


        if (document.readyState === 'loading') {

          document.addEventListener(
            'DOMContentLoaded',
            addGuaranteeBadge
          );

        } else {

          addGuaranteeBadge();

        }


        const observer =
          new MutationObserver(function () {
            addGuaranteeBadge();
          });

        observer.observe(document.body, {
          childList: true,
          subtree: true
        });

      })();
    </script>

<script>
(function () {
  'use strict';

  /*
   * OLDYFANS
   * Hace que los links de las tarjetas de producto en colecciones
   * abran directamente la variante correspondiente al color mostrado.
   */

  const variantCache = {};

  async function getProductData(handle) {
    if (variantCache[handle]) {
      return variantCache[handle];
    }

    try {
      const response = await fetch('/products/' + handle + '.js');

      if (!response.ok) {
        return null;
      }

      const product = await response.json();
      variantCache[handle] = product;

      return product;
    } catch (error) {
      console.error('OldyFans variant selector:', error);
      return null;
    }
  }

  function getVisibleMediaId(card) {
    /*
     * En tu HTML cada imagen/slide tiene:
     *
     * <slideshow-slide ... slide-id="43933217161261">
     *
     * Buscamos el slide que actualmente está visible.
     */

    const slides = card.querySelectorAll(
      'slideshow-slide[slide-id]'
    );

    for (const slide of slides) {
      const hidden = slide.hasAttribute('hidden');
      const ariaHidden = slide.getAttribute('aria-hidden');

      if (!hidden && ariaHidden !== 'true') {
        return slide.getAttribute('slide-id');
      }
    }

    /*
     * Fallback: si el theme no marca correctamente el slide,
     * usamos el primero.
     */
    if (slides.length) {
      return slides[0].getAttribute('slide-id');
    }

    return null;
  }

  function getHandleFromUrl(url) {
    try {
      const parsed = new URL(url, window.location.origin);

      const match = parsed.pathname.match(
        /\/products\/([^\/]+)/
      );

      return match ? match[1] : null;

    } catch (error) {
      return null;
    }
  }

  async function handleProductClick(event) {

    /*
     * Solo nos interesan clicks que terminen entrando a un producto.
     */
    const link = event.target.closest(
      'a[href*="/products/"]'
    );

    if (!link) {
      return;
    }

    const card = link.closest('product-card');

    if (!card) {
      return;
    }

    /*
     * Si ya tiene una variante específica, no hacemos nada.
     */
    const originalUrl = link.href;

    if (/[?&]variant=\d+/.test(originalUrl)) {
      /*
       * Aunque tenga variant, la reemplazamos por la variante
       * correspondiente a la imagen/color de esta tarjeta.
       */
    }

    const handle = getHandleFromUrl(originalUrl);

    if (!handle) {
      return;
    }

    const mediaId = getVisibleMediaId(card);

    if (!mediaId) {
      return;
    }

    /*
     * Evitamos que el theme navegue antes de terminar
     * de identificar la variante.
     */
    event.preventDefault();
    event.stopPropagation();

    const product = await getProductData(handle);

    if (!product || !product.variants) {
      window.location.href = originalUrl;
      return;
    }

    /*
     * Buscamos la variante cuya imagen destacada corresponde
     * al slide que se está mostrando en la tarjeta.
     */
    let matchingVariant = product.variants.find(function (variant) {

      if (
        variant.featured_media &&
        String(variant.featured_media.id) === String(mediaId)
      ) {
        return true;
      }

      return false;
    });

    /*
     * Compatibilidad con estructuras antiguas de Shopify.
     */
    if (!matchingVariant) {
      matchingVariant = product.variants.find(function (variant) {

        if (
          variant.featured_image &&
          variant.featured_image.id &&
          String(variant.featured_image.id) === String(mediaId)
        ) {
          return true;
        }

        return false;
      });
    }

    /*
     * Si encontramos la variante correspondiente al color,
     * entramos directamente con ese ID.
     */
    if (matchingVariant) {

      const destination =
        '/products/' +
        handle +
        '?variant=' +
        matchingVariant.id;

      window.location.href = destination;

    } else {

      /*
       * Si por alguna razón no encontramos correspondencia,
       * mantenemos el comportamiento normal.
       */
      window.location.href = originalUrl;
    }
  }

  /*
   * Usamos captura para adelantarnos al comportamiento
   * normal del link del theme.
   */
  document.addEventListener(
    'click',
    handleProductClick,
    true
  );

})();
</script>

