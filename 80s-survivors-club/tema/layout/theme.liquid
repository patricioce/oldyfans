      <script>
        document.addEventListener('DOMContentLoaded', function () {

          function addSaleBadge() {

            const priceContainer =
              document.querySelector('product-price');

            if (!priceContainer) return;

            if (
              priceContainer.querySelector('.custom-sale-badge')
            ) return;

            const price =
              priceContainer.querySelector(
                '.fake-sale-new, .price-item--sale, .price-item--last, .price-item__group.price:not(.compare-at-price)'
              );

            if (!price) return;

            const badge =
              document.createElement('span');

            badge.className =
              'custom-sale-badge';

            badge.textContent = 'SALE';

            price.insertAdjacentElement(
              'afterend',
              badge
            );

          }

          addSaleBadge();

          const priceContainer =
            document.querySelector('product-price');

          if (priceContainer) {

            const observer =
              new MutationObserver(function () {
                addSaleBadge();
              });

            observer.observe(priceContainer, {
              childList: true,
              subtree: true
            });

          }

        });
      </script>

