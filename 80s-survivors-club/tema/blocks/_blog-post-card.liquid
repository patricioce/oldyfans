{%- assign block_settings = block.settings -%}

{% liquid
  if block_settings.background_color != blank
    render 'contrast-override', background_color: block_settings.background_color, section_id: block.id
  endif
%}

{% if block_settings.background_color != blank %}
  {% style %}
    blog-posts-list[section-id="{{ section.id }}"] .blog-post-item {
      --color-background: {{ block_settings.background_color }};
    }
  {% endstyle %}
{% endif %}

<div
  class="blog-post-card{% if block_settings.background_color != blank %} color-custom-{{ block.id }}{% endif %}"
  style="--text-align: {{ block_settings.alignment }}"
>
  {% if article.image %}
    {% content_for 'block', id: 'image', type: '_blog-post-image', article: article %}
  {% endif %}

  <div class="blog-post-card__content">
    <a
      class="blog-post-card__title-link"
      href="{{ article.url }}"
      data-testid="blog-post-link"
    >
      {%- comment -%}BMP-HOOK-START:blog-card-heading{%- endcomment -%}
      {%- comment -%}
        The card title shipped as a bare <div>, so no blog card title was a
        heading. templates/blog.json sets this _heading block's `text` to "", which
        makes snippets/text.liquid take its empty-text fallback branch
        (`fallback_text != blank and visible_text == blank`) — that branch hardcodes
        a <div> and can never emit a heading tag, whatever `type_preset` says.

        Fixing it from the template JSON does not work. `closest.article` is not
        populated inside blog-posts-list: verified live against the rendered page,
        where a literal `<h2>x</h2>` and `{{ closest.blog.title }}` both render, but
        `{{ closest.article.title }}` and the loop's own `article` both interpolate
        to empty. The empty value strips to nothing, so the same fallback fires and
        the failure is silent — the title still shows, still as a <div>.

        text.liquid emits `{{ fallback_text }}` unescaped, so passing the markup in
        through `text:` puts a real <h2> inside the block's own wrapper div — the
        same div-wrapper + heading-child shape the product cards already produce via
        the `plain_text` branch. Keeps snippets/text.liquid byte-identical to
        upstream, which is the constraint this edit was built under.
      {%- endcomment -%}
      {%- capture blog_card_heading -%}<h2>{{ article.title }}</h2>{%- endcapture -%}
      {%- content_for 'block', id: 'heading', type: '_heading', text: blog_card_heading -%}
      {%- comment -%}BMP-HOOK-END:blog-card-heading{%- endcomment -%}
    </a>

    {% content_for 'block',
      id: 'blog-post-details',
      type: '_blog-post-info-text',
      alignment: block_settings.alignment,
      article: article
    %}

    {% content_for 'block', id: 'content', type: '_blog-post-description', article: article, show_read_more: true %}
  </div>
</div>

{% stylesheet %}
  .blog-post-card {
    display: flex;
    flex-direction: column;
    text-align: var(--text-align);
    column-gap: var(--columns-gap);
  }

  .blog-post-item--horizontal:has(.blog-post-card__image-container) .blog-post-card {
    & > *:first-child {
      flex-basis: 70%;
    }

    & > *:last-child {
      flex-basis: 30%;
    }
  }

  .blog-post-card__content {
    padding-block-start: 0.4rem;
    display: flex;
    flex-direction: column;
  }

  .blog-post-item--horizontal .blog-post-card__title-link .spacing-style,
  .blog-post-item--horizontal .blog-post-details,
  .blog-post-item--horizontal .blog-post-card__content-text {
    padding-inline-start: 0;
  }

  .blog-post-item .blog-post-card__image-container,
  .blog-post-item .blog-post-card__content {
    width: 100%;
  }

  /**
   * Horizontal layout (image left, content right)
   * Applied to hero posts based on total article count
   * Only applies the split layout when an image is actually present
   */
  .blog-post-item--horizontal .blog-post-card {
    flex-direction: row;

    @media screen and (max-width: 749px) {
      flex-direction: column;
    }
  }

  .blog-post-card__content a {
    display: block;
    text-wrap: pretty;
    text-decoration: none;
    padding-block-start: 0.75rem;
    color: var(--color-foreground);
  }

  .blog-post-card__content a:hover {
    color: var(--color-foreground-subdued);
  }

  a.blog-post-card__title-link {
    color: var(--color-foreground);

    &:hover {
      color: var(--color-foreground-subdued);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.blog_post",
  "settings": [
    {
      "type": "text_alignment",
      "id": "alignment",
      "label": "t:settings.alignment",
      "default": "left"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    }
  ]
}
{% endschema %}
