{% render 'text-block-styles' %}

{%- liquid
  assign block_settings = block.settings
  assign product_resource = closest.product
  assign selected_variant = product_resource.selected_or_first_available_variant
-%}
{%- comment -%}BMP-HOOK-START:card-global-price-behavior{%- endcomment -%}
{%- liquid
  assign bmp_show_sale_price_first = block_settings.show_sale_price_first
  assign bmp_show_tax_info = block_settings.show_tax_info
  assign bmp_show_installments = block_settings.show_installments
  assign bmp_show_from = block_settings.bmp_price_from
  if block_settings.bmp_use_global_style
    assign bmp_show_sale_price_first = settings.bmp_card_price_sale_first
    assign bmp_show_tax_info = settings.bmp_card_price_tax_info
    assign bmp_show_installments = settings.bmp_card_price_installments
    assign bmp_show_from = settings.bmp_price_from_show
  endif
-%}
{%- comment -%}BMP-HOOK-END:card-global-price-behavior{%- endcomment -%}

{% liquid
  if block_settings.type_preset == 'rte' or block_settings.type_preset == 'paragraph'
    assign is_rte = true
  endif

  capture text_block_classes
    if block_settings.width == '100%'
      echo 'text-block--align-' | append: block_settings.alignment
      if block_settings.max_width == 'none'
        echo ' text-block--full-width'
      endif
    endif
    if block_settings.type_preset == 'custom'
      echo ' custom-typography'
      if block_settings.font_size != ''
        echo ' custom-font-size'
      endif
      if block_settings.color != ''
        echo ' custom-color'
      endif
    endif
    if block_settings.background
      echo ' text-block--background'
    endif
    if is_rte
      echo ' rte'
    endif
  endcapture
%}

<product-price
  class="text-block {{ text_block_classes }} text-{{ block_settings.alignment }} {{ block_settings.type_preset | default: 'paragraph' }} spacing-style{% comment %}BMP-HOOK-START:card-global-price-class{% endcomment %}{% if block_settings.bmp_use_global_style %} bmp-card-global-price{% endif %}{% comment %}BMP-HOOK-END:card-global-price-class{% endcomment %}"
  data-block-id="{{ block.id }}"
  data-product-id="{{ product_resource.id }}"
  style="
    {% render 'typography-style', settings: block_settings %}
    {% render 'spacing-style', settings: block_settings %}
    {% if block_settings.text_color != blank %}
      --color: {{ block_settings.text_color }};
      --color-rgb: {{ block_settings.text_color.rgb }};
    {% endif %}
    --width: {{ block_settings.width }};
  "
  {{ block.shopify_attributes }}
>
  {% comment %}BMP-HOOK-START:card-global-price-sale-first{% endcomment %}{% if false %}{% comment %}BMP-HOOK-END:card-global-price-sale-first{% endcomment %}{% render 'price',
    show_unit_price: true,
    product_resource: product_resource,
    show_sale_price_first: block_settings.show_sale_price_first
  %}{% comment %}BMP-HOOK-START:card-global-price-sale-first-close{% endcomment %}{% endif %}{% # theme-check-disable UnrecognizedRenderSnippetArguments %}{% render 'price',
    show_unit_price: true,
    product_resource: product_resource,
    show_sale_price_first: bmp_show_sale_price_first,
    bmp_show_from: bmp_show_from
  %}{% # theme-check-enable UnrecognizedRenderSnippetArguments %}{% comment %}BMP-HOOK-END:card-global-price-sale-first-close{% endcomment %}

  {% comment %}BMP-HOOK-START:card-global-price-tax{% endcomment %}{% if bmp_show_tax_info %}{% comment %}BMP-HOOK-END:card-global-price-tax{% endcomment %}
    <div class="tax-note">
      {%- if cart.duties_included and cart.taxes_included -%}
        {{ 'content.duties_and_taxes_included' | t }}
      {%- elsif cart.taxes_included -%}
        {{ 'content.taxes_included' | t }}
      {%- elsif cart.duties_included -%}
        {{ 'content.duties_included' | t }}
      {%- endif -%}

      {%- if shop.shipping_policy.body != blank -%}
        {{ 'content.shipping_policy' | t }}
      {%- endif -%}
    </div>
  {% endif %}

  {%- comment -%}BMP-HOOK-START:card-global-price-installments{%- endcomment -%}{%- if selected_variant != blank and bmp_show_installments -%}{%- comment -%}BMP-HOOK-END:card-global-price-installments{%- endcomment -%}
    <div class="installments">
      {%- assign product_form_installment_id = 'product-form-installment-' | append: block.id -%}
      {%- form 'product', product_resource, id: product_form_installment_id, class: 'payment-terms' -%}
        <input
          type="hidden"
          name="id"
          value="{{ selected_variant.id }}"
        >
        {{ form | payment_terms }}
      {%- endform -%}
    </div>
  {%- endif -%}
</product-price>

{% render 'payment-terms-styles' %}

{% comment %}
  BMP-SCHEMA:card-global-price — the schema JSON below carries a BMP delta:
  one additive bmp_use_global_style checkbox, plus bmp-gated visible_if terms
  appended to the native settings so local controls hide while the block
  follows the global card style (JSON cannot carry Liquid markers).

  The schema carries a SECOND, independent delta announced by the one-line
  comment right below — bmp_price_from, joining the variant-price
  treatment on 2026-08-17. Same mirror shape as the three native behavior
  checkboxes: the block checkbox governs while bmp_use_global_style is off,
  and the global bmp_price_from_show — moved the same day from its original
  BMP: Pricing panel into the Card price (global) group — takes over while
  it is on (alias-when-off in BMP-HOOK:card-global-price-behavior). Default
  false keeps a fresh install byte-identical to stock; the ONE toggle-off
  instance in the tree (templates/product.json main PDP price) was seeded
  with bmp_price_from: true in the same commit, because the live store has
  the global ON and PDP "From" must survive the handover. The alias is
  threaded through render 'price' into bmp-price-variation, whose default
  chain (allow_false: true) keeps every caller that does not pass the param
  on the global.
{%- endcomment -%}
{%- comment -%}BMP-SCHEMA:price-variation - additive schema delta: setting id "bmp_price_from" (checkbox, default false), visible only while bmp_use_global_style is off; per-block half of the settings.bmp_price_from_show mirror (Card price (global) group), resolved into the bmp_show_from alias by BMP-HOOK:card-global-price-behavior and threaded through render 'price' into snippets/bmp-price-variation.liquid{%- endcomment -%}
{% schema %}
{
  "name": "t:names.product_price",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "t:content.resource_reference_product_price"
