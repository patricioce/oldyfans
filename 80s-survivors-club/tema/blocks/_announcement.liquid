{% render 'text-block-styles' %}

{%- assign block_settings = block.settings -%}
{%- assign plain_text = block_settings.text | strip_newlines | strip_html | strip -%}
{%- assign block_index = section.blocks | find_index: 'id', block.id -%}

{%- comment -%}BMP-HOOK-START:announcement-countdown-state{%- endcomment -%}
{%- liquid
  # This block's own countdown state ONLY — no cross-block sibling scan.
  # A sibling's .settings is unreadable from inside another block's own
  # render pass in Horizon's theme-block architecture (measured live,
  # 2026-08-13: for/loop, bracket-index and the map filter all return the
  # CURRENT block's settings correctly and every OTHER block's settings
  # empty; sections/header-announcements.liquid was probed too and cannot
  # read block settings either). block_index therefore stays the untouched
  # native find_index value; the aria-hidden edge case this can leave open
  # — a slide other than block_index==0 surviving alone when an earlier
  # block is server-skipped — is corrected client-side by
  # assets/bmp-countdown-fallback.js, loaded below (BMP-HOOK:announcement-
  # countdown-fallback) only when THIS block's own state is 'hidden'.
  capture bmp_cd_state
    render 'bmp-countdown', settings: block_settings, mode: 'state'
  endcapture
  assign bmp_cd_state = bmp_cd_state | strip
-%}
{%- comment -%}BMP-HOOK-END:announcement-countdown-state{%- endcomment -%}

{%- unless plain_text == '' -%}
  {%- comment -%}BMP-HOOK-START:announcement-countdown-hide{%- endcomment -%}{%- if bmp_cd_state != 'hidden' -%}{%- comment -%}BMP-HOOK-END:announcement-countdown-hide{%- endcomment -%}
  <slideshow-slide
    ref="slides[]"
    class="
      announcement-bar__slide
      text-block
      text-block--{{ block.id }}
      text-block--align-center
      text-block--full-width
      custom-typography
      {% if block_settings.font_size != "" %}custom-font-size{% endif %}
      {% if block_settings.weight != "" %}custom-font-weight{% endif %}
    "
    style="
      {% render 'typography-style', settings: block_settings, preset: 'custom' %}
      {% if block_settings.text_color != blank %}--color: {{ block_settings.text_color }}; --color-rgb: {{ block_settings.text_color.rgb }};{% endif %}
      --width: 100%;
      --text-align: center;
      --line-height: 1;
    "
    {{ block.shopify_attributes }}
    aria-hidden="{% if block_index == 0 %}false{% else %}true{% endif %}"
  >
    <p class="announcement-bar__text">
      {{ block.settings.text }}
    </p>
    {%- comment -%}BMP-HOOK-START:announcement-countdown-render{%- endcomment -%}{%- if bmp_cd_state == 'active' -%}{%- render 'bmp-countdown', settings: block_settings -%}{%- endif -%}{% comment %}BMP-HOOK-END:announcement-countdown-render{% endcomment %}

    {% if block_settings.link != blank %}
      <a
        class="announcement-bar__link"
        href="{{ block_settings.link }}"
      >
        <span class="visually-hidden">
          {{ block_settings.text | strip_html }}
        </span>
      </a>
    {% endif %}
  </slideshow-slide>
  {%- comment -%}BMP-HOOK-START:announcement-countdown-hide-close{%- endcomment -%}{%- endif -%}{%- comment -%}BMP-HOOK-END:announcement-countdown-hide-close{%- endcomment -%}
  {%- comment -%}BMP-HOOK-START:announcement-countdown-fallback{%- endcomment -%}{%- if bmp_cd_state == 'hidden' -%}{%- render 'bmp-countdown', settings: block_settings, mode: 'fallback' -%}{%- endif -%}{%- comment -%}BMP-HOOK-END:announcement-countdown-fallback{%- endcomment -%}
{%- endunless -%}

{% comment %}
  BMP-SCHEMA:announcement-countdown — the schema JSON below carries one purely additive BMP delta:
  4 settings (bmp_countdown_show, bmp_countdown_end_date, bmp_countdown_end_time, bmp_countdown_hide_on_end)
  appended after text_color, behind a t:bmp.content.bmp_countdown header. Consumed by this file's
  BMP-HOOK:announcement-countdown-state / -hide / -render hooks, which render
  snippets/bmp-countdown.liquid.
{%- endcomment -%}
