{%- doc -%}
  This block is used to display the accelerated checkout button.
  Intended for product-form.liquid block.

  @param {string} can_add_to_cart - Whether the product can be added to the cart
  @param form_obj - The form object

  @example
  {% content_for 'block', type: 'accelerated-checkout', id: 'accelerated-checkout', can_add_to_cart: can_add_to_cart, form_obj: form %}
{%- enddoc -%}

{% liquid
  assign product = closest.product
  if request.visual_preview_mode and product == blank
    assign product = collections.all.products.first
  endif
%}
{%- comment -%}BMP-HOOK-START:size-required-express{%- endcomment -%}
{%- comment -%}
  Forced-size gate, decision D1: this block renders Shopify's own `form_obj | payment_button`
  below, which posts through Shopify's script rather than through
  ProductFormComponent.handleSubmit — Layer 1 cannot intercept it at all, so
  hiding the button is the only reliable control over it. An unhidden Shop Pay
  button sells the smallest size straight past both enforcement layers.

  The capture lives OUTSIDE the native {% liquid %} tag above: Liquid markers
  are invalid inside one. The verdict comes from the same shared snippet
  blocks/buy-buttons.liquid uses, never from a second copy of the condition.
{%- endcomment -%}
{%- capture bmp_size_state -%}
  {%- render 'bmp-size-required-state', product_resource: product -%}
{%- endcapture -%}
{%- assign bmp_size_state = bmp_size_state | strip -%}
{%- comment -%}BMP-HOOK-END:size-required-express{%- endcomment -%}

{% capture accelerated_checkout_button %}
  {% if product != blank and form_obj != blank %}
    {{ form_obj | payment_button }}
  {% endif %}
{% endcapture %}

{% if accelerated_checkout_button != blank %}
  <div
    class="accelerated-checkout-block"
    ref="acceleratedCheckoutButtonContainer"
    {{ block.shopify_attributes }}
    {% if request.visual_preview_mode %}
      data-shopify-visual-preview
    {% endif %}
    {% unless can_add_to_cart %}
      hidden
    {% endunless %}
    {%- comment -%}BMP-HOOK-START:size-required-express{%- endcomment -%}
    {%- comment -%}
      Extends the native sold-out condition above to the forced-size gate.
      assets/bmp-size-required.js unhides the container when the gate opens.

      The `can_add_to_cart and` half is load-bearing, not redundant: without it
      a variant that is BOTH sold out and unchosen satisfies the native
      `unless` AND this branch, emitting `hidden` twice on the same element —
      a duplicate attribute, which is invalid HTML.
    {%- endcomment -%}
    {%- if can_add_to_cart and bmp_size_state == 'closed' -%}
      hidden
    {%- endif -%}
    {%- comment -%}BMP-HOOK-END:size-required-express{%- endcomment -%}
  >
    {{ accelerated_checkout_button }}
  </div>
{% endif %}

{% render 'buy-buttons-styles' %}

{% schema %}
{
  "name": "t:names.accelerated_checkout",
  "tag": null
}
{% endschema %}
